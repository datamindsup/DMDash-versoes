    "fontes":  [
                   {
                       "nome":  "relatorios",
                       "sql":  "-- Fonte \"relatorios\" dos dashboards DM BI no DMDash (PostgreSQL/Supabase), a partir da vista materializada ltable.\n-- Uma linha por linha de relatório, como no Looker Studio. Os campos calculados do Looker estão aqui (ver DM-BI.md).\n-- Parâmetros do dashboard: @Desde, @Ate (datas da análise) e @ParCli (número; 0 = todos os clientes).\n-- O texto do \"Filtro\" (lin.filtro1…4) não vai no SQL: é o filtro de cada tabela, com o parâmetro ?Filtro.\nSELECT\n    l.\"lin.rdata\"::date                                   AS data,          -- dia do relatório (lin.rdata)\n    l.\"cab.relid\"                                         AS relid,         -- para a ligação ao GoFormz\n    l.\"cab.relnum\"                                        AS relnum,\n    l.\"lin.linnum\"                                        AS linha,\n    l.\"cab.relmodname\"                                    AS modulo,        -- Mod (DM, DMRP, …)\n    l.\"lin.relmodname\"                                    AS modulolinha,\n    l.\"cab.relstatus\"                                     AS estado,\n    l.\"cab.tecnico\"                                       AS tecnico,\n    CASE l.\"cab.tecnico\"\n        WHEN \u0027Sérgio Fernandes\u0027 THEN \u0027SF\u0027 WHEN \u0027Ricardo Stuart\u0027 THEN \u0027RS\u0027 WHEN \u0027José Rossas\u0027 THEN \u0027JR\u0027\n        WHEN \u0027José Augusto Dias\u0027 THEN \u0027AD\u0027 WHEN \u0027José António Lima\u0027 THEN \u0027JL\u0027 WHEN \u0027Pedro Costa\u0027 THEN \u0027PC\u0027\n        WHEN \u0027Sara Vilasboas\u0027 THEN \u0027SV\u0027 WHEN \u0027Andreia Sobral\u0027 THEN \u0027AS\u0027 WHEN \u0027Victor Afonso\u0027 THEN \u0027VF\u0027\n        WHEN \u0027Consultor\u0027 THEN \u0027CS\u0027 WHEN \u0027Consultor Contabilístico\u0027 THEN \u0027CC\u0027 WHEN \u0027Andreia Lima\u0027 THEN \u0027AL\u0027\n        WHEN \u0027Jorge Torres\u0027 THEN \u0027JT\u0027 WHEN \u0027Vera Alves\u0027 THEN \u0027VA\u0027 WHEN \u0027Domingos Costa\u0027 THEN \u0027DC\u0027\n        WHEN \u0027Carolina Pereira\u0027 THEN \u0027CP\u0027 WHEN \u0027Catarina Barros\u0027 THEN \u0027CB\u0027 WHEN \u0027Bruna Sampaio\u0027 THEN \u0027BS\u0027\n    END                                                   AS tc,            -- cab.tc\n    l.\"cab.tipo\"                                          AS tipo,\n    l.\"cab.classificacao\"                                 AS classificacao,\n    l.\"cab.clinum\"                                        AS clinum,\n    l.\"cab.clinome\"                                       AS cliente,\n    l.\"cab.assunto\"                                       AS assunto,\n    CASE WHEN l.\"cab.tday\" \u003e 5 THEN \u0027DD\u0027 ELSE \u0027DT\u0027 END    AS diatipo,       -- cab.diatipo (DD = descanso, DT = trabalho)\n    l.\"cab.cmdata\"::date                                  AS datafecho,     -- Data Fecho (completeddate)\n    CASE WHEN EXTRACT(DOW FROM l.\"cab.rdata\") \u003c 6         -- cab.difdatas (como no Looker: só o sábado dá 0)\n         THEN (l.\"cab.cmdata\"::date - l.\"cab.rdata\"::date)\n              - ROUND((l.\"cab.cmdata\"::date - l.\"cab.rdata\"::date) / 7.0) * 2\n         ELSE 0 END                                       AS difdatas,\n    l.\"cab.dwdays\"                                        AS diasfecho,     -- dias úteis até ao fecho (sem feriados)\n    l.\"cab.dsdays\"                                        AS diascorridos,  -- dias seguidos até ao fecho\n    CASE WHEN l.\"cab.dwdays\" \u003c 4 THEN \u0027Até 3 Dias\u0027 ELSE \u0027Mais de 3 Dias\u0027 END AS difdiastrb,  -- cab.dwdayso\n    l.\"cab.mwdays\"                                        AS diasuteismes,\n    EXTRACT(YEAR FROM l.\"lin.rdata\")::int * 100 + EXTRACT(MONTH FROM l.\"lin.rdata\")::int AS anomes, -- 202611 (tot.mwdays: só com um mês)\n    l.\"lin.rdata\"::date::text || \u0027 \u0027 || l.\"cab.tecnico\"   AS diatecnico,    -- dia + técnico (tot.tlintectmp, tot.mediadttp)\n    left(l.\"cab.totalhours\", length(l.\"cab.totalhours\") - 3) AS thours,     -- cab.thours (\"HH:MM\")\n    l.\"lin.intervencao\"                                   AS intervencao,   -- ASSISTENCIA_TEC, VIAGEM, FERIAS, …\n    CASE l.\"lin.intervencao\"                              -- lin.ilin (Tipo)\n        WHEN \u0027ASSISTENCIA_TEC\u0027 THEN \u0027ATE\u0027 WHEN \u0027ASSISTENCIA_CON\u0027 THEN \u0027ACT\u0027 WHEN \u0027ASSISTENCIA_TOC\u0027 THEN \u0027ACO\u0027\n        WHEN \u0027CORRECAO_ERRO\u0027 THEN \u0027ERR\u0027 WHEN \u0027VIAGEM\u0027 THEN \u0027VIA\u0027 WHEN \u0027FORMACAO\u0027 THEN \u0027FOR\u0027 WHEN \u0027COMERCIAL\u0027 THEN \u0027COM\u0027\n        WHEN \u0027INTERNO\u0027 THEN \u0027INT\u0027 WHEN \u0027FALTAS\u0027 THEN \u0027FLT\u0027 WHEN \u0027FERIAS\u0027 THEN \u0027FER\u0027 WHEN \u0027RGP - RGPD\u0027 THEN \u0027RGP\u0027\n        WHEN \u0027COMPLEMENTAR\u0027 THEN \u0027CMP\u0027 ELSE l.\"lin.intervencao\" END AS ilin,\n    CASE l.\"lin.intervencao\"                              -- nome com o código, pela ordem do Looker (ver ordemintervencao)\n        WHEN \u0027ASSISTENCIA_TEC\u0027 THEN \u0027Assistência Técnica (ATE)\u0027 WHEN \u0027ASSISTENCIA_CON\u0027 THEN \u0027Assistência Contrato (ACT)\u0027\n        WHEN \u0027ASSISTENCIA_TOC\u0027 THEN \u0027Assistência TOC (ACO)\u0027 WHEN \u0027COMERCIAL\u0027 THEN \u0027Comercial (COM)\u0027\n        WHEN \u0027CORRECAO_ERRO\u0027 THEN \u0027Correção Erro (ERR)\u0027 WHEN \u0027FORMACAO\u0027 THEN \u0027Formação (FOR)\u0027 WHEN \u0027INTERNO\u0027 THEN \u0027Interno (INT)\u0027\n        WHEN \u0027VIAGEM\u0027 THEN \u0027Viagem (VIA)\u0027 WHEN \u0027FALTAS\u0027 THEN \u0027Faltas (FLT)\u0027 WHEN \u0027FERIAS\u0027 THEN \u0027Férias (FER)\u0027\n        WHEN \u0027RGP - RGPD\u0027 THEN \u0027RGP - RGPD (RGP)\u0027 WHEN \u0027COMPLEMENTAR\u0027 THEN \u0027Complementar (CMP)\u0027 ELSE l.\"lin.intervencao\" END AS tipointervencao,\n    CASE l.\"lin.intervencao\"\n        WHEN \u0027ASSISTENCIA_TEC\u0027 THEN 1 WHEN \u0027ASSISTENCIA_CON\u0027 THEN 2 WHEN \u0027ASSISTENCIA_TOC\u0027 THEN 3 WHEN \u0027COMERCIAL\u0027 THEN 4\n        WHEN \u0027CORRECAO_ERRO\u0027 THEN 5 WHEN \u0027FORMACAO\u0027 THEN 6 WHEN \u0027INTERNO\u0027 THEN 7 WHEN \u0027VIAGEM\u0027 THEN 8 WHEN \u0027FALTAS\u0027 THEN 9\n        WHEN \u0027FERIAS\u0027 THEN 10 WHEN \u0027RGP - RGPD\u0027 THEN 11 WHEN \u0027COMPLEMENTAR\u0027 THEN 12 ELSE 99 END AS ordemintervencao,\n    l.\"lin.intlin\"                                        AS descricao,     -- lin.intlin (Descrição)\n    left(l.\"lin.hinilin\"::text, 5)                        AS ini,\n    left(l.\"lin.hfimlin\"::text, 5)                        AS fim,           -- lin.fim\n    l.\"lin.faclin\"                                        AS fac,\n    substring(l.\"lin.htotlin\"::text, 1, 2)::int * 3600\n      + substring(l.\"lin.htotlin\"::text, 4, 2)::int * 60  AS tempo,         -- lin.tlin: segundos da linha (formato \"duracao\")\n    CASE WHEN l.\"lin.intervencao\" = \u0027ASSISTENCIA_CON\u0027 THEN substring(l.\"lin.htotlin\"::text, 1, 2)::int * 3600\n      + substring(l.\"lin.htotlin\"::text, 4, 2)::int * 60 END AS tempoact,   -- lin.tlinact (só ACT)\n    CASE WHEN l.\"lin.intervencao\" = \u0027ASSISTENCIA_TEC\u0027 THEN substring(l.\"lin.htotlin\"::text, 1, 2)::int * 3600\n      + substring(l.\"lin.htotlin\"::text, 4, 2)::int * 60 END AS tempoate,   -- lin.tlinate (só ATE)\n    CASE WHEN l.\"lin.intervencao\" = \u0027VIAGEM\u0027 THEN l.\"cab.rdata\"::date END AS dataviagem, -- tot.cddesloca2 (contar = dias com viagem)\n    CASE WHEN l.\"lin.intervencao\" = \u0027VIAGEM\u0027\n         THEN l.\"cab.rdata\"::date::text || \u0027 \u0027 || l.\"cab.clinum\" END AS deslocacao,  -- tot.cddesloca (contar = deslocações dia+cliente)\n    l.\"cli.clinhorascontrato\"                             AS horascontrato, -- para lin.tlinactper (% das horas do contrato); NHoras\n    l.\"cli.clitelefone\"                                   AS telefone,      -- ficha do cliente (página 1)\n    l.\"cli.clicontratos\"                                  AS contratos,\n    l.\"cli.cliobsaltcontrato\"                             AS obscontrato,   -- Obs\u0026Alt\n    l.\"cli.clidatainicontrato\"                            AS iniciocontrato,\n    l.\"cli.clidatafimcontrato\"                            AS fimcontrato,\n    l.\"cli.clindeslocacontrato\"                           AS deslocacoescontrato,\n    l.\"tot.tdtotal\"                                       AS tempodia,      -- total do técnico nesse dia, em segundos\n    to_char(l.\"lin.rdata\"::date, \u0027YYYYMMDD\u0027)::bigint * 1000000\n      + l.\"cab.relnum\"::bigint                            AS recente        -- dia + RelNum: o máximo é o relatório mais recente (Assunto)\nFROM ltable AS l\nWHERE l.\"lin.rdata\"::date BETWEEN @Desde AND @Ate\n  AND (@ParCli = 0 OR l.\"cab.clinum\" = @ParCli)                             -- cab.clinum.filtrourl",
                       "soColunasUsadas":  true,
                       "colunas":  [
                                       "data",
                                       "relnum",
                                       "tecnico",
                                       "tc",
                                       "ilin",
                                       "tempo"
                                   ]
                   }
               ],
